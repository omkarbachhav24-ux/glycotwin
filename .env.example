# Backend. Omit DATABASE_URL to fall back to a local SQLite file, which is the
# quickest way to run without Postgres.
GLYCOTWIN_DATABASE_URL=postgresql+psycopg2://glycotwin:glycotwin@localhost:5432/glycotwin
GLYCOTWIN_CORS_ORIGINS=http://localhost:3000
GLYCOTWIN_DEFAULT_STREAM_INTERVAL_SECONDS=1.0

# Frontend. Next inlines this at build time.
NEXT_PUBLIC_API_BASE=http://localhost:8000
